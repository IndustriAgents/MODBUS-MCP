# Example settings for modbus-mcp. Copy to modbus-python/.env and edit.
#
# Where settings come from, highest precedence first:
#   1. the process environment (for example the "env" block of your MCP
#      client's server configuration);
#   2. a file passed explicitly with `modbus-mcp --env-file PATH` (read in full);
#   3. modbus-python/.env of a source checkout, loaded automatically. It is
#      found relative to the package source; a .env in the working directory
#      or in any parent directory is never read, and an installed package
#      (site-packages) has no automatic .env at all.
#
# The automatically loaded .env (3) is limited:
#   - it may set only modbus-mcp's own settings: MODBUS_* and REGISTER_MAP_FILE.
#     Anything else (PATH, LD_PRELOAD, DYLD_*, PYTHON*, ...) is ignored with a
#     warning on stderr;
#   - it may NOT set the write switch MODBUS_WRITES_ENABLED, in any spelling
#     (keys are compared case-insensitively, `export` and quotes included). It
#     is only honoured from (1) or (2); here it is ignored with a warning.
# The reason: whoever controls the files around the server should not be able
# to switch writes on, or redirect them to another device.

MODBUS_TYPE=tcp
MODBUS_HOST=127.0.0.1
MODBUS_PORT=1502
MODBUS_DEFAULT_SLAVE_ID=1

# Serial (MODBUS_TYPE=serial)
# MODBUS_SERIAL_PORT=/dev/ttyUSB0
# MODBUS_BAUDRATE=9600
# MODBUS_PARITY=N
# MODBUS_STOPBITS=1
# MODBUS_BYTESIZE=8
# MODBUS_TIMEOUT=1

# Reliability: retries apply to reads and to (re)connecting; a write is sent at most once.
# MODBUS_MAX_RETRIES=2
# MODBUS_RETRY_BACKOFF_BASE=0.2
# MODBUS_TOOL_TIMEOUT=
# Overall deadline for one tool call, in seconds (reads end with an error, a
# write in flight is reported as "unknown"):
# MODBUS_CALL_TIMEOUT=30

# Tag map
# REGISTER_MAP_FILE=/absolute/path/to/tags.json

# Write switch: ignored in the automatically loaded .env (see above). Set it in
# the process environment, or in a file passed with --env-file.
# MODBUS_WRITES_ENABLED=true
