# Example settings for modbus-mcp. Copy to .env (in modbus-python/) and edit.
#
# Where settings come from, highest precedence first:
#   1. the process environment (for example the "env" block of your MCP
#      client's server configuration);
#   2. a file passed explicitly with `modbus-mcp --env-file PATH`;
#   3. a .env file found automatically, by searching up from the installed
#      package's directory (for a checkout: modbus-python/.env).
#
# A .env found automatically (3) may set connection settings, but NOT the
# write switch. When an MCP client launches the server, that search can reach
# the client's own project, which may not be trusted, so MODBUS_WRITES_ENABLED
# is only honoured from (1) or (2). If it appears in an automatically found
# .env, the server ignores it and prints a warning on stderr naming it.

MODBUS_TYPE=tcp
MODBUS_HOST=127.0.0.1
MODBUS_PORT=1502
MODBUS_DEFAULT_SLAVE_ID=1

# Serial (MODBUS_TYPE=serial)
# MODBUS_SERIAL_PORT=/dev/ttyUSB0
# MODBUS_BAUDRATE=9600
# MODBUS_PARITY=N
# MODBUS_STOPBITS=1
# MODBUS_BYTESIZE=8
# MODBUS_TIMEOUT=1

# Reliability: retries apply to reads and to (re)connecting; a write is sent at most once.
# MODBUS_MAX_RETRIES=2
# MODBUS_RETRY_BACKOFF_BASE=0.2
# MODBUS_TOOL_TIMEOUT=

# Tag map
# REGISTER_MAP_FILE=/absolute/path/to/tags.json

# Write switch: ignored in an automatically found .env (see above). Set it in
# the process environment, or in a file passed with --env-file.
# MODBUS_WRITES_ENABLED=true
